     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[2, 3, 4, 5, 7, 8, 9, 10]\n"
     ]
    }
   ],
   "source": [
    "dup_list = [5,7,7,4,5,3,4,3,8,9,2,8,9,10,5]\n",
    "\n",
    "unique_list = list(set(dup_list))\n",
    "\n",
    "print(unique_list)"

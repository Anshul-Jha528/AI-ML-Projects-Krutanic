   "source": [
    "###  Duplicate Removal Write a single line of code to remove duplicates from a list and return unique values. "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "87a9b2a0-bc41-4f6a-b89e-f775e68c89ee",

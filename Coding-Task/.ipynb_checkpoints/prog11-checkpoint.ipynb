   "source": [
    "### List Intersection Write a program to find common elements between two lists using the membership operator in. "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "ef8b7384-6caf-4683-856c-63524bf6ef3c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[5, 6]\n"
     ]
    }
   ],
   "source": [
    "list1 = [4,5,3,7,6,20]\n",
    "list2 = [2,8,5,9,12,6]\n",
    "\n",
    "inter_list = []\n",
    "\n",
    "for i in list1:\n",
    "    if i in list2:\n",
    "        inter_list.append(i)\n",
    "\n",
    "print(inter_list)"
   ]

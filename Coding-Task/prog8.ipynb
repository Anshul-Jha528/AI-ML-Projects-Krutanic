   "source": [
    "###  Reverse an Integer Using a while loop and arithmetic operators (// and %), reverse the digits of an integer. "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "0cc53e23-bbb2-4cf2-88e7-dfeb96e5396f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a number:  3452879\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Reversed number:  9782543\n"
     ]
    }
   ],
   "source": [
    "num = int(input(\"Enter a number: \"))\n",
    "rev = 0\n",
    "while num>0:\n",
    "    rev = rev*10+(num%10)\n",
    "    num = num//10\n",
    "print(\"Reversed number: \",rev)"
   ]
  },
